e # =============================================================================
# VisionAI Configuration
# =============================================================================
# Copy this file to `.env` and update the values for your environment.
#
# cp .env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension enabled
# Format: postgresql+psycopg://user:password@host:port/database
VISIONAI_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/visionai_db

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Directory where uploaded images are stored (relative to project root)
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Ollama Configuration
# -----------------------------------------------------------------------------
# Base URL for the Ollama API server
OLLAMA_BASE_URL=http://localhost:11434

# Vision model used for generating image descriptions
# Options: llava:latest, llava:13b, qwen2.5vl:latest
OLLAMA_MODEL=llava:latest

# Text model used for generating embeddings (must support embeddings API)
# Options: llama3.1:latest, nomic-embed-text, mxbai-embed-large
OLLAMA_EMBEDDING_MODEL=llama3.1:latest

# Embedding vector dimension (must match the model's output)
# llama3.1:latest = 4096, nomic-embed-text = 768, mxbai-embed-large = 1024
OLLAMA_EMBEDDING_DIMENSION=4096

